#!/usr/bin/env bash
# Prueba .claude/hooks/require-gates.sh en un repo desechable, con un remoto local y un
# `gh` de mentira. El hook es el CI de sunrise (docs/DECISIONES.md §12): si deja pasar lo
# que no debe, nada más lo pilla. Lo corre `bin/gates`; a mano: `bin/test-hook`.
set -uo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
HOOK="$here/.claude/hooks/require-gates.sh"
T="$(mktemp -d)"
trap 'rm -rf "$T"' EXIT
# El texto del push va partido: así el hook real no juzga al que lee o corre este archivo.
P="git"" push"
fails=0

# `gh pr view` responde el HEAD de la carpeta, o FAKE_HEAD para simular un PR de otra rama.
mkdir -p "$T/stub"
printf '#!/bin/sh\n[ "$1 $2" = "pr view" ] && echo "${FAKE_HEAD:-$(git rev-parse HEAD)}"\n' > "$T/stub/gh"
chmod +x "$T/stub/gh"
export PATH="$T/stub:$PATH"

git init -q --bare -b main "$T/remote.git"
git clone -q "$T/remote.git" "$T/repo" 2> /dev/null
cd "$T/repo"
git config user.email t@t; git config user.name t; git config commit.gpgsign false
mkdir -p bin; cp "$here/bin/tree-hash" bin/
echo a > a.txt; git add -A; git commit -qm init; $P -q origin main
stampf="$(git rev-parse --git-path sunrise-gates-ok)"
seal() { bin/tree-hash > "$stampf"; }

run() { # descripción, código esperado, comando
  local out code
  out="$(jq -n --arg c "$3" --arg d "$PWD" '{tool_input:{command:$c},cwd:$d}' | bash "$HOOK" 2>&1)"
  code=$?
  if [ "$code" = "$2" ]; then
    echo "  ok   [$code] $1"
  else
    echo "  FAIL [${code}, se esperaba ${2}] $1 :: $out"
    fails=$((fails + 1))
  fi
}

echo "▸ Tags, desde main"
rm -f "$stampf"
run "tag que todavía no existe" 2 "$P origin v1.0.0"
run "crear y empujar el tag en el mismo comando" 2 "git tag v1.0.0 && $P origin v1.0.0"
git tag v1.0.0
# Sin sello y pasa: las suites del tag las corre release.yml antes de compilar (#32).
run "tag existente sin sello, en main" 0 "$P origin v1.0.0"
seal
run "tag existente con sello" 0 "$P origin v1.0.0"
run "borrar un tag pasa libre" 0 "$P origin :refs/tags/v1.0.0"
run "tag nuevo sobre otro commit en el mismo comando" 2 "git tag v3.0.0 HEAD~0 && $P origin v3.0.0"
run "tag anotado con -m sobre otro rev" 2 "git tag -a -m 'sunrise 9' v9.0.1 HEAD~0 && $P origin v9.0.1"
run "borrar el tag local y el remoto en un comando" 0 "git tag -d v1.0.0 ; $P origin :refs/tags/v1.0.0"
echo b > b.txt; git add -A; git commit -qm b
run "tag viejo: se juzga su commit, no HEAD" 0 "$P origin v1.0.0"
git tag v1.0.1
run "tag sin sello fuera de origin/main" 2 "$P origin v1.0.1"
seal
run "tag sellado pero fuera de origin/main" 2 "$P origin v1.0.1"
run "push de rama y tag en el mismo comando, desde main" 2 "$P && $P origin v1.0.0"
run "push pelado desde main" 2 "$P"
run "tag seguido de otro refspec" 2 "$P origin v1.0.0 main"
run "--tags" 2 "$P --tags"
run "--follow-tags" 2 "$P --follow-tags origin"
run "push … tag vX" 2 "$P origin tag v1.0.0"
run "tag con -f" 2 "$P -f origin v1.0.0"
run "tag como src:dst" 2 "$P origin v1.0.0:v1.0.0"
run "tag como refs/tags/x:refs/tags/x" 2 "$P origin refs/tags/v1.0.0:refs/tags/v1.0.0"
run "tag a una URL en vez de origin" 2 "$P $T/remote.git v1.0.0"
run "borrado con --delete" 2 "$P --delete origin v1.0.0"
git reset -q --hard origin/main; git tag -d v1.0.1 > /dev/null
seal
run "pull, tag y push en el mismo comando" 2 "git pull --ff-only && git tag v5.0.0 && $P origin v5.0.0"
git tag -a v5.0.0 -m 'versión'
run "tag anotado ya creado, empujado aparte" 0 "$P origin v5.0.0"
run "push -q de un tag" 0 "$P -q origin v5.0.0"
echo f > f.txt; git add -A; git commit -qm f; $P -q origin main
run "git tag -f mueve un tag existente: bloquea" 2 "git tag -f v5.0.0 && $P origin v5.0.0"
git tag v6.0.0 HEAD~1; seal
run "retaguear en el mismo comando que el push" 2 "git tag -d v6.0.0; git tag v6.0.0 && $P origin v6.0.0"
run "tag local viejo, crear y empujar con ; sin borrarlo" 2 "git tag v6.0.0; $P origin v6.0.0"
git tag -d v6.0.0 > /dev/null
run "commit cuyo mensaje dice push no es un push" 0 "git commit -m 'commit y push separados'"
run "git -C … tag sobre otro rev en el mismo comando" 2 "git -C $PWD tag v7.0.0 HEAD~1 && git -C $PWD push origin v7.0.0"
run "git -C … tag -f en el mismo comando" 2 "git -C $PWD tag -f v5.0.0 && git -C $PWD push origin v5.0.0"
# Falso bloqueo conocido y aceptado: el texto de un mensaje se lee como comando. Por eso
# los mensajes de commit van con `git commit -F <archivo>`.
run "mensaje que cita un git push literal (usar -F)" 2 "git commit -m 'antes: $P origin HEAD:main'"

echo "▸ Rama de issue"
git checkout -qb issue-1-x
echo c > c.txt; git add -A; git commit -qm c; seal
run "push de la rama sellada" 0 "$P -u origin HEAD"
$P -q -u origin HEAD
run "gh pr create sellado" 0 "gh pr create --title x"
run "tag sobre una rama de issue" 2 "$P origin v4.0.0"
run "destino main con HEAD:main" 2 "$P origin HEAD:main"
run "destino main por nombre" 2 "$P origin main"
run "destino main con +" 2 "$P origin +main"
run "destino refs/heads/main" 2 "$P origin refs/heads/main"
run "--all" 2 "$P --all origin"
run "--mirror" 2 "$P --mirror origin"
run "destino main entre comillas simples" 2 "$P origin 'HEAD:main'"
run "destino main entre comillas dobles" 2 "$P origin \"HEAD:main\""
run "--delete main" 2 "$P origin --delete main"
run "git -c … push" 2 "git -c x=y push origin HEAD:main"
run "git con ruta absoluta" 2 "/usr/bin/$P origin HEAD:main"
run "push dentro de sh -c" 2 "sh -c '$P origin HEAD:main'"
run "push dentro de \$(…)" 2 "x=\$($P origin HEAD:main)"
run "push a la rama de la issue por nombre" 0 "$P origin issue-1-x"
run "--force-with-lease tras un rebase" 0 "$P --force-with-lease origin HEAD"
run "con 2>&1 y tail" 0 "$P -u origin HEAD 2>&1 | tail -3"
run "commit y push en el mismo comando" 2 "git commit -qam x && $P origin HEAD"
run "commit, push y merge en el mismo comando" 2 "git commit -qam x && $P origin HEAD && gh pr merge 1 --squash"
run "commit con git -c, push y merge" 2 "git -c commit.gpgsign=false commit -qam x && $P origin HEAD && gh pr merge 1 --squash"
run "commit con VAR=x delante y push" 2 "HUSKY=0 git commit -qam x && $P origin HEAD"
run "commit con --no-pager y push" 2 "git --no-pager commit -qam x && $P origin HEAD"
run "commit con ruta absoluta y push" 2 "/usr/bin/git commit -qam x && $P origin HEAD"
run "redirección a archivo no parte el push" 0 "$P -u origin HEAD > /dev/null 2>&1"
run "rebase y push en el mismo comando" 2 "git rebase origin/main && $P --force-with-lease origin HEAD"
echo junk > untracked.txt; seal
run "sello con un archivo sin trackear" 2 "$P origin HEAD"
rm untracked.txt; seal
echo e >> c.txt
run "cambio sin commitear después de sellar: lo que viaja sí se probó" 0 "$P origin HEAD"
git checkout -q -- c.txt

git checkout -qb release-v0.2.0; seal
run "rama y tag en el mismo comando, desde una rama" 2 "git tag v0.2.0 && $P -u origin HEAD && $P origin v0.2.0"
run "tag y gh pr create en el mismo comando" 2 "git tag v0.2.0 && $P origin v0.2.0 && gh pr create --title x"
git checkout -q issue-1-x; git branch -qD release-v0.2.0; seal

echo "▸ Merge"
run "merge en orden" 0 "gh pr merge 1 --squash"
run "flags con valor antes del número" 0 "gh pr merge --subject x 1 --squash"
FAKE_HEAD=deadbeef run "el PR es de otra rama" 2 "gh pr merge 7 --squash --repo o/r"
FAKE_HEAD=deadbeef run "merge dentro de \$(…)" 2 "x=\$(gh pr merge 7 --squash)"
FAKE_HEAD=deadbeef run "merge dentro de sh -c" 2 "sh -c 'gh pr merge 7 --squash'"
FAKE_HEAD=deadbeef run "gh con ruta absoluta" 2 "/opt/homebrew/bin/gh pr merge 7 --squash"
echo d > d.txt; git add -A; git commit -qm d; seal
run "merge sin empujar" 2 "gh pr merge 1 --squash"
$P -q origin HEAD
git checkout -q main; echo m > m.txt; git add -A; git commit -qm m; $P -q origin main
git checkout -q issue-1-x
run "merge con main adelantado" 2 "gh pr merge 1 --squash"
git rebase -q origin/main; $P -q -f origin HEAD; seal
run "merge tras rebase, gates y push" 0 "gh pr merge 1 --squash"
REPO="$PWD"; cd /
run "con cd a la worktree delante" 0 "cd $REPO && gh pr merge 1 --squash"
run "con cd entre comillas simples" 0 "cd '$REPO' && gh pr merge 1 --squash"
run "cd fuera de un repo" 2 "cd / && git -C $REPO push"
cd "$REPO"
git checkout -qb issue-2-sin-upstream; seal
run "rama sin upstream" 2 "gh pr merge 2 --squash"
run "comando ajeno" 0 "ls -la"

if [ "$fails" -gt 0 ]; then
  echo "✗ $fails casos del hook fallaron" >&2
  exit 1
fi
echo "✓ Hook en verde"
